# Node settings for scripts/migrate.sh and scripts/replication-*.sh.
# Copy to replication/nodes.env (ignored by git) and fill in.
# Passwords are commented out so that values exported in the shell (e.g. read
# from the cloud's secret store just before running a script) are not
# overwritten. Uncomment only on a trusted machine.

# Participating nodes (two or three). Names are lowercase cloud IDs and must
# match CLOUD_ID of the API on that cloud.
NODES="aws google azure"
DB_NAME=appdb

# Per node: NODE_<NAME>_<FIELD>
#   HOST            address reachable from where the scripts run
#   REPL_HOST       address the other databases use to reach this one
#                   (optional; defaults to HOST)
#   PORT            default 5432
#   SSLMODE         default require
#   PLATFORM        aws | google | azure | postgres (default: the node name)
#   ADMIN_USER / ADMIN_PASSWORD   database admin (runs migrations, creates
#                                 the publication and subscriptions)
#   REPL_USER / REPL_PASSWORD     role the other nodes connect as
#   API_USER / API_PASSWORD       role the API connects as (DB_USER / DB_PASSWORD)

NODE_AWS_HOST=
NODE_AWS_ADMIN_USER=
# NODE_AWS_ADMIN_PASSWORD=
NODE_AWS_REPL_USER=app_repl
# NODE_AWS_REPL_PASSWORD=
NODE_AWS_API_USER=app_api
# NODE_AWS_API_PASSWORD=

NODE_GOOGLE_HOST=
NODE_GOOGLE_ADMIN_USER=
# NODE_GOOGLE_ADMIN_PASSWORD=
NODE_GOOGLE_REPL_USER=app_repl
# NODE_GOOGLE_REPL_PASSWORD=
NODE_GOOGLE_API_USER=app_api
# NODE_GOOGLE_API_PASSWORD=

NODE_AZURE_HOST=
NODE_AZURE_ADMIN_USER=
# NODE_AZURE_ADMIN_PASSWORD=
NODE_AZURE_REPL_USER=app_repl
# NODE_AZURE_REPL_PASSWORD=
NODE_AZURE_API_USER=app_api
# NODE_AZURE_API_PASSWORD=
