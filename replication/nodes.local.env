# Node settings for the local compose environment (compose.yaml).
# Passwords come from the "tools" service environment.
NODES="${NODES:-aws google azure}"
DB_NAME=appdb

NODE_AWS_HOST=pg-aws
NODE_GOOGLE_HOST=pg-google
NODE_AZURE_HOST=pg-azure

for _node in AWS GOOGLE AZURE; do
  declare "NODE_${_node}_PLATFORM=postgres"
  declare "NODE_${_node}_SSLMODE=disable"
  declare "NODE_${_node}_ADMIN_USER=admin"
  declare "NODE_${_node}_REPL_USER=app_repl"
  declare "NODE_${_node}_API_USER=app_api"
done
unset _node
