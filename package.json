{
  "name": "multicloud-api-apps",
  "version": "0.1.0",
  "private": true,
  "description": "GraphQL CRUD API deployed active/active to AWS, Google Cloud and Azure",
  "license": "MIT",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p .",
    "test": "jest",
    "generate": "npm run build && node dist/generate.js"
  },
  "engines": {
    "node": ">=24.0"
  },
  "dependencies": {
    "graphql": "^17.0.2",
    "graphql-yoga": "^5.24.1",
    "pg": "^8.23.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "typescript": "^5.9.3"
  }
}
