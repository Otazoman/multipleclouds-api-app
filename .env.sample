# Environment variables read by the API (src/config.ts).
# On each cloud, the container platform sets these (secrets from the cloud's
# secret store). Copy to .env only for running the API outside compose.

# Cloud this instance runs on: aws | google | azure
CLOUD_ID=aws
PORT=8080
# Serve the GraphiQL IDE on /graphql. Keep false on the clouds.
GRAPHIQL_ENABLED=false
# Commit the image was built from, returned by the health endpoints. Set by
# the Dockerfile (build argument from the CI/CD); default "unknown".
# APP_VERSION=

DB_HOST=localhost
DB_PORT=5432
DB_NAME=appdb
DB_USER=app_api
DB_PASSWORD=
# disable | require | verify-full
DB_SSLMODE=require
# CA bundle file for DB_SSLMODE=verify-full (optional)
DB_SSL_CA_FILE=
# Pool size for this cloud's database (reads, and writes while it is the
# primary) and for each other node (writes only).
DB_POOL_MAX=4
DB_PEER_POOL_MAX=3

# Write routing (docs/architecture.md, "Writes"). Every API reads from DB_*
# above and writes to the primary, which may be any node.
# The other nodes, comma-separated (empty: single node).
PEER_NODES=google,azure
# Per node in PEER_NODES: HOST and PASSWORD are required; PORT (5432), NAME,
# USER, SSLMODE and SSL_CA_FILE default to the DB_* values above.
DB_GOOGLE_HOST=
DB_GOOGLE_PASSWORD=
DB_AZURE_HOST=
DB_AZURE_PASSWORD=
# Other nodes that must flush a write before it is reported as successful
# (default 1; 0 when PEER_NODES is empty).
WRITE_ACK_PEERS=1
WRITE_ACK_TIMEOUT_MS=3000
PRIMARY_REFRESH_INTERVAL_MS=5000

# Journal pruning job only (node dist/prune.js): days the write journal keeps
# a write and its idempotency key (default 30).
JOURNAL_RETENTION_DAYS=30
