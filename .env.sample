# Environment variables read by the API (src/config.ts).
# On each cloud, the container platform sets these (secrets from the cloud's
# secret store). Copy to .env only for running the API outside compose.

# Cloud this instance runs on: aws | google | azure
CLOUD_ID=aws
PORT=8080
# Serve the GraphiQL IDE on /graphql. Keep false on the clouds.
GRAPHIQL_ENABLED=false

DB_HOST=localhost
DB_PORT=5432
DB_NAME=appdb
DB_USER=app_api
DB_PASSWORD=
# disable | require | verify-full
DB_SSLMODE=require
# CA bundle file for DB_SSLMODE=verify-full (optional)
DB_SSL_CA_FILE=
DB_POOL_MAX=10
